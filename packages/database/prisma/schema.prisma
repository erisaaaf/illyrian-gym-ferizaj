// Illyrian Gym Ferizaj - Database Schema
// PostgreSQL + Prisma. This is the single source of truth for the domain
// model shared by the API, admin dashboard, and mobile app (via generated
// types). See docs/database.md for migration, indexing, and concurrency
// notes (booking capacity, PR concurrency, partial unique indexes).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  MEMBER
  COACH
  RECEPTIONIST
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  CANCELLED
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

enum ClassStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  BOOKED
  WAITLISTED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum WodSectionType {
  WARM_UP
  STRENGTH
  METCON
  COOLDOWN
}

enum WodType {
  AMRAP
  FOR_TIME
  EMOM
  TABATA
  STRENGTH
  CUSTOM
}

enum WodStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExerciseCategory {
  WEIGHTLIFTING
  GYMNASTICS
  CARDIO
  BODYWEIGHT
  STRONGMAN
  MOBILITY
  OTHER
}

enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MeasurementType {
  WEIGHT
  REPS
  TIME
  DISTANCE
  ROUNDS
}

enum PrType {
  MAX_WEIGHT
  MAX_REPS
  FASTEST_TIME
  MAX_DISTANCE
  MAX_ROUNDS
}

enum PrUnit {
  KG
  LB
  KM
  MILES
  SECONDS
  MINUTES
  REPS
  ROUNDS
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum PrSource {
  AUTO_DETECTED
  MANUAL
  CORRECTED
}

enum AttendanceStatus {
  CHECKED_IN
  NO_SHOW
  CANCELLED
}

enum ChallengeStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_CANCELLATION
  CLASS_REMINDER
  NEW_WOD
  NEW_PR
  ANNOUNCEMENT
  MEMBERSHIP_EXPIRING
  CHALLENGE
  MESSAGE
  OFFER
  SCHEDULE_CHANGE
  PAYMENT_RECEIVED
  MEMBERSHIP_FROZEN
}

// What a membership covers (document 2.A: Gym, CrossFit, Combined).
enum MembershipType {
  GYM
  CROSSFIT
  COMBINED
}

// Package length (document 2.A: monthly, three-month, six-month, annual). CUSTOM keeps odd durations possible.
enum PackagePeriod {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM
}

enum PaymentMethod {
  CASH
  BANK
  CARD
}

// An invoice is OPEN or VOID. Whether it is paid / partial / overdue is derived from the payments linked to
// it, so the status can never drift out of sync with the money actually received.
enum InvoiceStatus {
  OPEN
  VOID
}

// A payment is a record of money RECEIVED. Corrections never delete it: it is voided (with reason, by whom).
enum PaymentRecordStatus {
  COMPLETED
  VOIDED
}

enum ExpenseCategory {
  RENT
  EQUIPMENT
  MAINTENANCE
  UTILITIES
  SALARIES
  MARKETING
  OTHER
}

enum VisitMethod {
  QR
  MANUAL
}

enum MembershipRequestType {
  RENEWAL
  FREEZE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageAudience {
  INDIVIDUAL
  ALL_ACTIVE
  EXPIRING_SOON
  EXPIRED
  UNPAID
  AT_RISK
  ASSIGNED_CLIENTS
}

enum WorkoutPlanStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// =============================================================================
// AUTH / USERS
// =============================================================================

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  role            Role       @default(MEMBER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  profileImageUrl String?
  deletedAt       DateTime?

  // Gym administration (members). memberNumber is generated by the API from a database sequence.
  memberNumber       String?  @unique
  assignedCoachId    String?
  assignedCoach      Coach?   @relation("CoachClients", fields: [assignedCoachId], references: [id], onDelete: SetNull)
  adminNotes         String? // staff-only; never shown to the member
  mustChangePassword Boolean  @default(false)
  qrVersion          Int      @default(1) // bump to invalidate a lost/shared QR card
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  coach                Coach?
  memberships          Membership[]
  bookings             Booking[]
  workoutResults       WorkoutResult[]
  personalRecords      PersonalRecord[]
  prHistoryEntries     PersonalRecordHistory[]  @relation("PrHistoryUser")
  prVerifications      PersonalRecordHistory[]  @relation("PrHistoryRecordedBy")
  attendance           Attendance[]
  attendanceMarked     Attendance[]             @relation("AttendanceMarkedBy")
  challengeEntries     ChallengeParticipant[]
  achievements         UserAchievement[]
  notifications        Notification[]
  aiConversations      AIConversation[]
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  emailVerifyTokens    EmailVerificationToken[]
  auditLogs            AuditLog[]               @relation("AuditActor")
  createdWods          Wod[]                    @relation("WodCreatedBy")
  createdAnnouncements Announcement[]           @relation("AnnouncementCreatedBy")
  createdChallenges    Challenge[]              @relation("ChallengeCreatedBy")

  invoices           Invoice[]           @relation("InvoiceMember")
  payments           Payment[]           @relation("PaymentMember")
  visits             GymVisit[]          @relation("VisitMember")
  membershipRequests MembershipRequest[] @relation("RequestMember")
  workoutPlans       WorkoutPlan[]       @relation("PlanMember")
  bodyMeasurements   BodyMeasurement[]
  progressPhotos     ProgressPhoto[]
  trainerNotesAbout  TrainerNote[]       @relation("NoteAboutMember")
  messagesReceived   MessageRecipient[]

  @@index([role])
  @@index([status])
  @@index([assignedCoachId])
}

model Coach {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String?
  certifications String[] @default([])
  specialties    String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classes Class[]
  clients User[]  @relation("CoachClients")

  @@index([isActive])
}

model RefreshToken {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedByJti String?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// =============================================================================
// MEMBERSHIPS
// =============================================================================

model MembershipPlan {
  id           String         @id @default(uuid())
  name         String
  description  String?
  durationDays Int
  planType     MembershipType @default(COMBINED)
  period       PackagePeriod  @default(MONTHLY)
  services     String[]       @default([]) // what the package includes, as entered by the gym
  priceCents   Int? // null until the gym confirms pricing - never invented
  currency     String         @default("EUR")
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  memberships Membership[]
}

model Membership {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  plan          MembershipPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  startDate     DateTime
  endDate       DateTime
  status        MembershipStatus @default(ACTIVE)
  paymentStatus PaymentStatus    @default(UNPAID) // derived from the invoices/payments linked to this membership
  cancelledAt   DateTime?

  // Commercial snapshot at assignment time (the plan price may change later).
  priceCents    Int?
  discountCents Int          @default(0)
  discountNote  String?
  renewedFromId String?
  renewedFrom   Membership?  @relation("MembershipRenewals", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewals      Membership[] @relation("MembershipRenewals")

  // Freeze: while now is inside [frozenFrom, frozenUntil) the membership is FROZEN. endDate is extended by
  // the frozen days when the freeze is created (and shortened again if the freeze is ended early).
  frozenFrom      DateTime?
  frozenUntil     DateTime?
  totalFrozenDays Int       @default(0)

  invoices  Invoice[]
  payments  Payment[]
  visits    GymVisit[]
  requests  MembershipRequest[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([userId])
  @@index([endDate])
  @@index([status])
}

// =============================================================================
// CLASSES / BOOKINGS
// =============================================================================

model Class {
  id          String      @id @default(uuid())
  title       String
  description String?
  coachId     String?
  coach       Coach?      @relation(fields: [coachId], references: [id], onDelete: SetNull)
  startTime   DateTime
  endTime     DateTime
  capacity    Int
  bookedCount Int         @default(0)
  status      ClassStatus @default(SCHEDULED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  bookings   Booking[]
  attendance Attendance[]

  @@index([startTime])
  @@index([coachId])
  @@index([status])
}

model Booking {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId     String
  class       Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  status      BookingStatus @default(BOOKED)
  bookedAt    DateTime      @default(now())
  cancelledAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  attendance Attendance?

  // NOTE: a partial unique index enforcing "at most one active (BOOKED or
  // WAITLISTED) booking per user per class" is added via a raw-SQL migration
  // because Prisma cannot express a filtered unique index natively.
  // See docs/database.md#booking-concurrency.
  @@index([userId])
  @@index([classId, status])
}

// =============================================================================
// WODS / EXERCISES
// =============================================================================

model Exercise {
  id              String             @id @default(uuid())
  name            String             @unique
  category        ExerciseCategory
  description     String?
  instructions    String?
  equipment       String[]           @default([])
  difficulty      ExerciseDifficulty @default(INTERMEDIATE)
  measurementType MeasurementType
  prType          PrType?
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  wodExercises    WodExercise[]
  workoutResults  WorkoutResult[]
  personalRecords PersonalRecord[]
  prHistory       PersonalRecordHistory[]

  planItems WorkoutPlanItem[]

  @@index([category])
  @@index([active])
}

model Wod {
  id          String    @id @default(uuid())
  title       String
  date        DateTime  @db.Date
  type        WodType
  description String?
  status      WodStatus @default(DRAFT)
  createdById String
  createdBy   User      @relation("WodCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sections       WodSection[]
  workoutResults WorkoutResult[]

  @@index([date])
  @@index([status])
}

model WodSection {
  id    String         @id @default(uuid())
  wodId String
  wod   Wod            @relation(fields: [wodId], references: [id], onDelete: Cascade)
  type  WodSectionType
  order Int
  notes String?

  exercises WodExercise[]

  @@index([wodId])
}

model WodExercise {
  id              String     @id @default(uuid())
  sectionId       String
  section         WodSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order           Int
  sets            Int?
  reps            Int?
  weightKg        Decimal?   @db.Decimal(6, 2)
  durationSeconds Int?
  restSeconds     Int?
  rounds          Int?
  timeCapSeconds  Int?
  instructions    String?
  scalingNotes    String?

  @@index([sectionId])
  @@index([exerciseId])
}

// =============================================================================
// WORKOUT TRACKING / PERSONAL RECORDS
// =============================================================================

model WorkoutResult {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wodId           String?
  wod             Wod?      @relation(fields: [wodId], references: [id], onDelete: SetNull)
  exerciseId      String?
  exercise        Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  sets            Int?
  reps            Int?
  weightKg        Decimal?  @db.Decimal(6, 2)
  durationSeconds Int?
  distanceMeters  Decimal?  @db.Decimal(8, 2)
  rounds          Int?
  calories        Int?
  notes           String?
  completedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())

  personalRecords       PersonalRecord[]
  personalRecordHistory PersonalRecordHistory[]

  @@index([userId, completedAt])
  @@index([wodId])
  @@index([exerciseId])
}

// Current-best PR per user/exercise. Authoritative, derived exclusively from
// WorkoutResult submissions (or explicit staff correction) - see
// docs/pr-engine.md. Never written to directly by client-submitted values.
model PersonalRecord {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId         String
  exercise           Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  recordType         PrType
  value              Decimal            @db.Decimal(10, 2)
  unit               PrUnit
  achievedAt         DateTime
  sourceWorkoutId    String?
  sourceWorkout      WorkoutResult?     @relation(fields: [sourceWorkoutId], references: [id], onDelete: SetNull)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedById       String?
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  history PersonalRecordHistory[]

  @@unique([userId, exerciseId])
  @@index([userId])
  @@index([exerciseId])
}

// Append-only, immutable audit trail of every PR change (auto-detected,
// manual entry, or coach correction). Never deleted.
model PersonalRecordHistory {
  id               String         @id @default(uuid())
  personalRecordId String
  personalRecord   PersonalRecord @relation(fields: [personalRecordId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation("PrHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  previousValue    Decimal?       @db.Decimal(10, 2)
  newValue         Decimal        @db.Decimal(10, 2)
  unit             PrUnit
  achievedAt       DateTime
  sourceWorkoutId  String?
  sourceWorkout    WorkoutResult? @relation(fields: [sourceWorkoutId], references: [id], onDelete: SetNull)
  source           PrSource       @default(AUTO_DETECTED)
  recordedById     String?
  recordedBy       User?          @relation("PrHistoryRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())

  @@index([userId, exerciseId, achievedAt])
  @@index([personalRecordId])
}

// =============================================================================
// ATTENDANCE
// =============================================================================

model Attendance {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId     String
  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  bookingId   String?          @unique
  booking     Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  status      AttendanceStatus @default(CHECKED_IN)
  checkedInAt DateTime?
  // Who last set/changed this record by hand (staff), and when. The full
  // history of changes lives in AuditLog.
  markedById  String?
  markedBy    User?            @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  markedAt    DateTime?
  createdAt   DateTime         @default(now())

  @@unique([userId, classId])
  @@index([classId])
}

// =============================================================================
// CHALLENGES / ACHIEVEMENTS
// =============================================================================

model Challenge {
  id          String          @id @default(uuid())
  title       String
  description String?
  rules       String?
  pointsLabel String          @default("points")
  startDate   DateTime
  endDate     DateTime
  status      ChallengeStatus @default(UPCOMING)
  createdById String
  createdBy   User            @relation("ChallengeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  participants ChallengeParticipant[]

  @@index([status])
  @@index([startDate, endDate])
}

model ChallengeParticipant {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  points      Int       @default(0)
  joinedAt    DateTime  @default(now())

  @@unique([challengeId, userId])
  @@index([challengeId, points])
}

model Achievement {
  id          String   @id @default(uuid())
  key         String   @unique
  title       String
  description String?
  iconUrl     String?
  criteria    Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

// =============================================================================
// ANNOUNCEMENTS / NOTIFICATIONS
// =============================================================================

model Announcement {
  id          String               @id @default(uuid())
  title       String
  content     String
  imageUrl    String?
  priority    AnnouncementPriority @default(NORMAL)
  status      AnnouncementStatus   @default(DRAFT)
  publishAt   DateTime?
  createdById String
  createdBy   User                 @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, publishAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

// =============================================================================
// PAYMENTS, INVOICES, EXPENSES (document 3.D)
//
// Money is stored in integer cents. Three different things are kept apart so reports are never wrong:
//   Invoice  = what the member owes (issued)            -> counts toward "billed"
//   Payment  = money actually received (COMPLETED)      -> the ONLY thing that counts as revenue
//   balance  = invoice total - completed payments       -> outstanding debt
// =============================================================================

model Invoice {
  id            String        @id @default(uuid())
  number        String        @unique // IG-<year>-<sequence>, from a database sequence
  userId        String
  user          User          @relation("InvoiceMember", fields: [userId], references: [id], onDelete: Restrict)
  membershipId  String?
  membership    Membership?   @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  issuedAt      DateTime      @default(now())
  dueDate       DateTime
  description   String
  subtotalCents Int
  discountCents Int           @default(0)
  totalCents    Int
  currency      String        @default("EUR")
  notes         String?
  status        InvoiceStatus @default(OPEN)
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?
  createdById   String
  createdAt     DateTime      @default(now())

  lines    InvoiceLine[]
  payments Payment[]

  @@index([userId])
  @@index([membershipId])
  @@index([issuedAt])
  @@index([status])
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  amountCents Int
}

model Payment {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation("PaymentMember", fields: [userId], references: [id], onDelete: Restrict)
  invoiceId    String?
  invoice      Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  membershipId String?
  membership   Membership?         @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  amountCents  Int
  currency     String              @default("EUR")
  method       PaymentMethod
  receivedAt   DateTime            @default(now())
  reference    String? // bank transfer reference, card slip number...
  notes        String?
  status       PaymentRecordStatus @default(COMPLETED)
  voidedAt     DateTime?
  voidedById   String?
  voidReason   String?
  recordedById String
  createdAt    DateTime            @default(now())

  @@index([userId])
  @@index([invoiceId])
  @@index([membershipId])
  @@index([receivedAt])
  @@index([status])
}

model Expense {
  id           String          @id @default(uuid())
  category     ExpenseCategory
  description  String
  amountCents  Int
  currency     String          @default("EUR")
  spentAt      DateTime
  recordedById String
  voidedAt     DateTime?
  voidedById   String?
  voidReason   String?
  createdAt    DateTime        @default(now())

  @@index([spentAt])
  @@index([category])
}

// Promotional discounts the staff can pick when assigning a membership (document 3.C "Discounts").
model Promotion {
  id             String    @id @default(uuid())
  name           String
  percentOff     Int? // 1-100, XOR amountOffCents
  amountOffCents Int?
  validFrom      DateTime?
  validTo        DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

// =============================================================================
// GYM ENTRY CHECK-IN (document 3.E) - separate from class attendance
// =============================================================================

model GymVisit {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation("VisitMember", fields: [userId], references: [id], onDelete: Cascade)
  membershipId String?
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  checkedInAt  DateTime    @default(now())
  method       VisitMethod
  recordedById String? // the staff member who scanned/entered it
  createdAt    DateTime    @default(now())

  @@index([userId, checkedInAt])
  @@index([checkedInAt])
}

// Member-initiated renewal / freeze requests, handled by staff (document 2.A "Kerkese per vazhdim ose ngrirje").
model MembershipRequest {
  id             String                @id @default(uuid())
  userId         String
  user           User                  @relation("RequestMember", fields: [userId], references: [id], onDelete: Cascade)
  membershipId   String?
  membership     Membership?           @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  type           MembershipRequestType
  requestedFrom  DateTime?
  requestedUntil DateTime?
  note           String?
  status         RequestStatus         @default(PENDING)
  handledById    String?
  handledAt      DateTime?
  handledNote    String?
  createdAt      DateTime              @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

// =============================================================================
// COACHING (document 3.F / 3.G / 4 / Trainer Portal)
// =============================================================================

// A plan a trainer (or admin) assigns to a member; it appears in the member's app through the same records.
model WorkoutPlan {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation("PlanMember", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  title       String
  goal        String?
  notes       String?
  startsOn    DateTime
  endsOn      DateTime?
  status      WorkoutPlanStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  items WorkoutPlanItem[]

  @@index([userId, status])
}

model WorkoutPlanItem {
  id              String      @id @default(uuid())
  planId          String
  plan            WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekday         Int // 1 = Monday ... 7 = Sunday
  position        Int         @default(0)
  exerciseId      String
  exercise        Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets            Int?
  reps            Int?
  weightKg        Decimal?    @db.Decimal(7, 2)
  durationSeconds Int?
  notes           String?

  @@index([planId, weekday])
}

// Comments and recommendations from a trainer about an assigned client. Staff-only.
model TrainerNote {
  id        String   @id @default(uuid())
  memberId  String
  member    User     @relation("NoteAboutMember", fields: [memberId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
}

// =============================================================================
// BODY PROGRESS (document 2 "Body Progress" - PRIVATE BY DEFAULT)
//
// Measurements and photos belong to the member. Nobody else can read them unless the member sets
// sharedWithCoach, and then only their assigned trainer can. Administrators never see private photos.
// =============================================================================

model BodyMeasurement {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  measuredAt      DateTime
  weightKg        Decimal? @db.Decimal(5, 2)
  bodyFatPercent  Decimal? @db.Decimal(4, 1)
  chestCm         Decimal? @db.Decimal(5, 1)
  waistCm         Decimal? @db.Decimal(5, 1)
  hipsCm          Decimal? @db.Decimal(5, 1)
  armCm           Decimal? @db.Decimal(5, 1)
  thighCm         Decimal? @db.Decimal(5, 1)
  notes           String?
  sharedWithCoach Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, measuredAt])
}

model ProgressPhoto {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  takenAt         DateTime
  mimeType        String
  sizeBytes       Int
  data            Bytes // stored in the database and only ever served through authorised endpoints
  note            String?
  sharedWithCoach Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, takenAt])
}

// =============================================================================
// COMMUNICATION CENTER (document 3.H)
//
// A message is delivered in-app by creating a Notification for each recipient. That is the only delivery
// channel that exists (no e-mail/SMS/push provider), so "delivered" means "in the member's app" and
// "read" comes from the notification's readAt - both are facts, nothing is estimated.
// =============================================================================

model Message {
  id             String           @id @default(uuid())
  subject        String
  body           String
  type           NotificationType
  audience       MessageAudience
  sentById       String
  recipientCount Int
  createdAt      DateTime         @default(now())

  recipients MessageRecipient[]

  @@index([createdAt])
}

model MessageRecipient {
  id             String  @id @default(uuid())
  messageId      String
  message        Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String? // the in-app notification created for this recipient (carries readAt)

  @@unique([messageId, userId])
  @@index([userId])
}

// =============================================================================
// AI ASSISTANT COACH
// =============================================================================

model AIConversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AIMessage[]

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AIMessageRole
  content        String
  tokenCount     Int?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

// =============================================================================
// AUDIT LOG
// =============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// =============================================================================
// GYM SETTINGS
// =============================================================================

// Singleton row (id is always "default") for real, staff-entered gym
// configuration. All fields start null - nothing here is ever defaulted to
// an invented value; the admin Settings page shows "not configured yet"
// until authorized staff enters it (spec section 22/26).
model GymSettings {
  id           String   @id @default("default")
  name         String?
  contactEmail String?
  contactPhone String?
  address      String?
  updatedById  String?
  updatedAt    DateTime @updatedAt

  // Operating rules the gym can change. Defaults are starting points to confirm with the gym, not facts.
  expiringSoonDays     Int     @default(7)
  atRiskShortDays      Int     @default(14)
  atRiskLongDays       Int     @default(30)
  duplicateScanMinutes Int     @default(10)
  blockUnpaidCheckIn   Boolean @default(false)
  maxFreezeDays        Int? // null = no limit configured (the freeze policy has not been confirmed)
  invoiceDueDays       Int     @default(0)
}
