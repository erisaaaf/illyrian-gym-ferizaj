    "seed:demo": "ts-node --transpile-only prisma/seed-demo.ts",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "@types/node": "^20.16.11",
    "@types/bcryptjs": "^2.4.6"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
