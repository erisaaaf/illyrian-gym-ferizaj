# Expo inlines any EXPO_PUBLIC_ variable into the client bundle at build
# time - never put secrets here. The mobile app talks to the API directly
# (with the access token in the Authorization header), unlike the admin
# dashboard which proxies through server-only Route Handlers.
#
# In development you normally need NOTHING here: the app works out the API address
# for the way you run it (see apps/mobile/lib/api-config.ts):
#   - browser / iOS simulator -> localhost
#   - physical phone (Expo Go) -> the PC that is serving the bundle (its LAN IP)
#   - Android emulator         -> 10.0.2.2
# The API port defaults to 3010. Override it if your API uses another port:
# EXPO_PUBLIC_API_PORT=3010
#
# Set a full URL to override all of the above (required for a production build):
# EXPO_PUBLIC_API_URL=https://api.example.com
