# ==============================================================================
# Illyrian Gym Ferizaj - Environment Configuration
# Copy this file to .env in apps/api (and packages/database) and fill in real
# values. NEVER commit the real .env file.
# ==============================================================================

# --- App ---
NODE_ENV=development
PORT=3010
API_URL=http://localhost:3010
CORS_ORIGINS=http://localhost:3001,http://localhost:8081,http://localhost:19006

# --- Database (PostgreSQL) ---
# Local dev via `docker compose up -d` (see docker-compose.yml). Uses host
# port 5434, not the default 5432, to avoid colliding with any other local
# Postgres (native service or another project's container):
# (the value below matches docker-compose.yml; it is a dev-only credential - use a real secret anywhere else)
DATABASE_URL=postgresql://illyrian:illyrian_dev_only@localhost:5434/illyrian_gym_dev

# --- Auth / JWT ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
# Members and trainers are created by the Admin. Leave false unless you deliberately want self-registration.
ALLOW_PUBLIC_REGISTRATION=false

# IANA timezone of the gym. Decides what "today" means for the WOD and training streaks.
GYM_TIMEZONE=Europe/Belgrade

# --- Email (verification / password reset) ---
# e.g. Resend, Postmark, SES - not yet chosen, see docs/architecture.md
EMAIL_PROVIDER=
EMAIL_FROM=no-reply@illyriangym.example
EMAIL_API_KEY=

# --- AI (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_CONTEXT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=800
AI_RATE_LIMIT_PER_USER_PER_DAY=50

# --- Push Notifications (Firebase Cloud Messaging) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- File Storage ---
# Choose one provider: cloudinary | s3
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
CLOUDINARY_URL=

# --- Rate Limiting ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# --- Observability ---
LOG_LEVEL=info
SENTRY_DSN=
